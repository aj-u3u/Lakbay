APP_NAME=Lakbay API
APP_ENV=local
API_V1_PREFIX=/api/v1
TIMEZONE=Asia/Manila
DEBUG=true
LOG_LEVEL=INFO

# Optional shared provider usage store. Required for multiple API workers.
PROVIDER_USAGE_REDIS_URL=

# Copy this from Neon. Prefer the pooled connection string for app traffic.
# Use the async SQLAlchemy driver form shown here.
DATABASE_URL=
ADMIN_REGISTRATION_CODE=
# JWT authentication.
# Generate JWT_SECRET_KEY locally. Do not commit the real value.
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=

# Public admin registration is allowed only when this code matches.
# You create this value and share it only with trusted project admins.
ADMIN_REGISTRATION_CODE=

# For local Flutter development, "*" is acceptable.
# Before production, replace "*" with the exact Flutter web/admin origins.
CORS_ALLOWED_ORIGINS=*
# Optional: allow localhost browser development on any port while keeping
# CORS_ALLOWED_ORIGINS limited to your hosted browser app's exact origin.
# CORS_ALLOWED_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$

# Get this from the Groq console.
GROQ_API_KEY=

# Keep model IDs configurable because provider availability can change.
GROQ_MODEL_DEFAULT=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-120b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b
# Second Groq model tried when the default is rate limited. Limits are per model,
# so use a different one (for example a qwen model) to get a separate quota.
GROQ_MODEL_FALLBACK=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACK is tried for chat only. Some models (e.g. qwen) cannot follow the
# strict itinerary JSON schema, so set this to true only if yours can.
GROQ_FALLBACK_FOR_ITINERARIES=false

# Optional second provider (OpenAI-compatible, e.g. Gemini) tried after the Groq
# models. FALLBACK_LLM_MODEL accepts several models separated by commas, each with
# its own quota. Leave the key empty to disable.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Keep these just under the provider's real limits (per model).
FALLBACK_LLM_REQUESTS_PER_MINUTE=10
FALLBACK_LLM_REQUESTS_PER_DAY=200

# Optional model slots for thesis comparison runs.
GROQ_MODEL_COMPARE_A=
GROQ_MODEL_COMPARE_B=
GROQ_MODEL_COMPARE_C=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=1
GROQ_TEMPERATURE=0.30
GROQ_MAX_TOKENS=4096
GROQ_USER_REQUESTS_PER_MINUTE=20
# Daily AI requests per user, so one account cannot use up the shared free quotas.
GROQ_USER_REQUESTS_PER_DAY=60
# Keep these just under the provider's real limits for the model.
GROQ_MODEL_REQUESTS_PER_MINUTE=20
GROQ_MODEL_REQUESTS_PER_DAY=1000
# Rate-limit waits up to this long are slept through and retried.
GROQ_RATE_LIMIT_MAX_WAIT_SECONDS=3
AI_ITINERARY_OPTION_COUNT=5
AI_MODEL_COMPARISON_ENABLED=false

# OSRM route service URL, either self-hosted or provider-hosted.
# The public demo server is acceptable for development only.
OSRM_BASE_URL=https://router.project-osrm.org
# Configure only after verifying this service uses a foot-profile graph.
OSRM_WALKING_BASE_URL=
OSRM_REQUEST_TIMEOUT_SECONDS=30
OSRM_PROFILE_DRIVING=driving
OSRM_PROFILE_WALKING=walking

# Admin-only OSM place lookup through Overpass. The backend caches results for 5 minutes.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_REQUEST_TIMEOUT_SECONDS=15
OVERPASS_REQUESTS_PER_MINUTE=10
ROUTE_MAX_DESTINATIONS=10
# Per-user limit for POST /routes/preview and /routes/optimize combined.
ROUTE_REQUESTS_PER_MINUTE=10
GEO_GROUP_REQUESTS_PER_MINUTE=10
PLANNING_ROUTE_REQUESTS_PER_MINUTE=10

# Optional live traffic through Google Routes API.
# Keep this blank until you enable Google Routes in Google Cloud.
GOOGLE_ROUTES_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
GOOGLE_ROUTES_REQUEST_TIMEOUT_SECONDS=20
GOOGLE_ROUTES_CACHE_TTL_SECONDS=300
GOOGLE_ROUTES_DAILY_REQUEST_LIMIT=150

# OpenWeather proxy used by Lakbay weather cards and weather-aware planning.
# Get this from https://openweathermap.org/api.
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_UNITS=metric
OPENWEATHER_LANG=en
OPENWEATHER_REQUEST_TIMEOUT_SECONDS=20
OPENWEATHER_REQUESTS_PER_MINUTE=45
OPENWEATHER_REQUESTS_PER_30_DAYS=100000
OPENWEATHER_CURRENT_CACHE_SECONDS=600
OPENWEATHER_FORECAST_CACHE_SECONDS=3600

# Cloudinary upload service.
# Get these from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=lakbay
CLOUDINARY_UPLOADS_PER_USER_DAY=10
CLOUDINARY_UPLOADS_PER_APP_DAY=50
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
